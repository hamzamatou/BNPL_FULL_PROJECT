OLLAMA_URL=http://localhost:11434/api/generate
# Modele leger par defaut dans le code (llama3.2:3b) ; ici surcharge explicite :
OLLAMA_MODEL=llama3.2:3b
OLLAMA_TIMEOUT_SEC=90
OLLAMA_MAX_OCR_CHARS=5000
# Limite les tokens generes (JSON court) pour des reponses plus rapides (0 = desactive).
OLLAMA_NUM_PREDICT=512
# Un seul appel Ollama pour tous les documents du dossier (recommande pour la latence).
COHERENCE_LLM_BATCH=true
# Timeout dedie au mode batch (0 = auto: max(OLLAMA_TIMEOUT_SEC, min(300, OLLAMA_TIMEOUT_SEC * nb_docs))).
OLLAMA_TIMEOUT_BATCH_SEC=0
# Plafond tokens pour la reponse JSON batch (plusieurs documents).
OLLAMA_NUM_PREDICT_BATCH=2048
OCR_LANG=fra+ara+eng
# Si tesseract n'est pas dans le PATH : chemin complet.
# Sous Windows, preferer des / pour eviter que \t soit lu comme une tabulation :
# TESSERACT_CMD=C:/Program Files/Tesseract-OCR/tesseract.exe
TESSERACT_CMD=
# Nombre de threads pour l'OCR sur les documents d'une meme requete (Tesseract en sous-processus).
COHERENCE_OCR_WORKERS=4
# Si 8 chiffres CIN trouves dans l'OCR, pas d'appel Ollama pour la CIN (true/false).
COHERENCE_SKIP_LLM_FOR_CIN=true
# true = regex avant LLM (defaut, plus rapide). false = LLM d'abord, regex si valeur vide.
COHERENCE_REGEX_FIRST=true
# Redimensionne l'image avant Tesseract si le plus grand cote depasse (0 = desactive).
OCR_IMAGE_MAX_EDGE=2200
