<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.46.1">
  <message id="Message_AnnulationCommercant" name="Message_AnnulationCommercant" />
  <process id="Process_BNPL" name="Processus BNPL" isExecutable="true" camunda:historyTimeToLive="180">
    <laneSet id="LaneSet_BNPL">
      <lane id="Lane_Analyste" name="Analyste Bancaire">
        <flowNodeRef>Task_RouterDemande</flowNodeRef>
        <flowNodeRef>Task_PriseEnCharge</flowNodeRef>
        <flowNodeRef>Task_ExpirerVerrou</flowNodeRef>
        <flowNodeRef>Task_PrendreDecision</flowNodeRef>
        <flowNodeRef>Task_DemanderComplement</flowNodeRef>
        <flowNodeRef>Task_CloreArchiverDemande</flowNodeRef>
        <flowNodeRef>GW_Decision</flowNodeRef>
        <flowNodeRef>EndEvent_Cloturee</flowNodeRef>
        <flowNodeRef>GW_RefusPartiel</flowNodeRef>
        <flowNodeRef>Timer_Expiration48h</flowNodeRef>
      </lane>
      <lane id="Lane_Client" name="Client">
        <flowNodeRef>Task_ValiderConsentement</flowNodeRef>
      </lane>
      <lane id="Lane_ServiceIA" name="Service IA">
        <flowNodeRef>Task_VerifierCoherence</flowNodeRef>
        <flowNodeRef>Activity_0juifhr</flowNodeRef>
        <flowNodeRef>Task_GenererRecommandations</flowNodeRef>
        <flowNodeRef>Task_Prescoring</flowNodeRef>
        <flowNodeRef>GW_Coherence</flowNodeRef>
        <flowNodeRef>GW_Score</flowNodeRef>
        <flowNodeRef>EndEvent_RejetAuto</flowNodeRef>
      </lane>
      <lane id="Lane_Commercant" name="Commerçant">
        <flowNodeRef>Task_AnalyserDemande</flowNodeRef>
        <flowNodeRef>Task_SoumettreDemande</flowNodeRef>
        <flowNodeRef>SubProcess_AnnulationCommercant</flowNodeRef>
        <flowNodeRef>StartEvent_Debut</flowNodeRef>
        <flowNodeRef>StartEvent_AnnulationCommercant</flowNodeRef>
        <flowNodeRef>EndEvent_Annulee</flowNodeRef>
      </lane>
    </laneSet>
    <startEvent id="StartEvent_Debut" name="Début">
      <outgoing>sf_1</outgoing>
    </startEvent>
    <userTask id="Task_AnalyserDemande" name="Analyser la demande">
      <incoming>Flow_0wwwpgy</incoming>
      <outgoing>sf_2</outgoing>
    </userTask>
    <userTask id="Task_SoumettreDemande" name="Soumettre la demande de financement">
      <outgoing>sf_8</outgoing>
    </userTask>
    <serviceTask id="Task_VerifierCoherence" name="Vérifier cohérence et détecter anomalies" camunda:type="external" camunda:topic="verification-coherence">
      <outgoing>sf_3</outgoing>
    </serviceTask>
    <exclusiveGateway id="GW_Coherence" name="Données cohérentes ?" default="sf_incoherent">
      <outgoing>sf_coherent</outgoing>
      <outgoing>sf_incoherent</outgoing>
    </exclusiveGateway>
    <serviceTask id="Activity_0juifhr" name="proposer des corrections" camunda:type="external" camunda:topic="proposer-corrections">
      <incoming>sf_incoherent</incoming>
      <outgoing>Flow_0wwwpgy</outgoing>
    </serviceTask>
    <serviceTask id="Task_GenererRecommandations" name="Générer des recommandations ciblées" camunda:type="external" camunda:topic="recommandations">
      <outgoing>sf_5</outgoing>
    </serviceTask>
    <userTask id="Task_ValiderConsentement" name="Valider le consentement">
      <incoming>sf_8</incoming>
      <outgoing>sf_client_3</outgoing>
    </userTask>
    <serviceTask id="Task_Prescoring" name="Évaluer le score interne" camunda:type="external" camunda:topic="prescoring">
      <incoming>sf_client_3</incoming>
      <outgoing>sf_11</outgoing>
    </serviceTask>
    <exclusiveGateway id="GW_Score" name="Score suffisant ?" default="sf_score_faible">
      <outgoing>sf_score_faible</outgoing>
      <outgoing>sf_score_ok</outgoing>
    </exclusiveGateway>
    <endEvent id="EndEvent_RejetAuto" name="Rejet automatique">
      <incoming>sf_score_faible</incoming>
      <terminateEventDefinition id="TerminateEventDefinition_RejetAuto" />
    </endEvent>
    <serviceTask id="Task_RouterDemande" name="Router vers banque partenaire via API scoring" camunda:type="external" camunda:topic="routage-banque">
      <outgoing>sf_12</outgoing>
    </serviceTask>
    <userTask id="Task_PriseEnCharge" name="Prendre en charge de la demande">
      <incoming>sf_12</incoming>
      <incoming>sf_exp_to_pec</incoming>
      <incoming>sf_refus_partiel</incoming>
      <outgoing>sf_pec_to_ins</outgoing>
    </userTask>
    <serviceTask id="Task_ExpirerVerrou" name="Expirer" camunda:type="external" camunda:topic="expiration-prise-en-charge">
      <incoming>sf_timer_to_exp</incoming>
      <outgoing>sf_exp_to_pec</outgoing>
    </serviceTask>
    <userTask id="Task_PrendreDecision" name="Instruire et décider">
      <incoming>sf_pec_to_ins</incoming>
      <incoming>Flow_0bmwscr</incoming>
      <outgoing>sf_analyste_3</outgoing>
    </userTask>
    <boundaryEvent id="Timer_Expiration48h" name="48h" attachedToRef="Task_PrendreDecision">
      <outgoing>sf_timer_to_exp</outgoing>
      <timerEventDefinition id="TimerDef_Expiration48h">
        <timeDuration xsi:type="tFormalExpression">PT48H</timeDuration>
      </timerEventDefinition>
    </boundaryEvent>
    <exclusiveGateway id="GW_Decision" name="Décision ?" default="sf_complement">
      <incoming>sf_analyste_3</incoming>
      <outgoing>sf_accepte</outgoing>
      <outgoing>sf_refuse</outgoing>
      <outgoing>sf_complement</outgoing>
    </exclusiveGateway>
    <serviceTask id="Task_DemanderComplement" name="Demander des informations complémentaires" camunda:type="external" camunda:topic="demander-complement">
      <incoming>sf_complement</incoming>
      <outgoing>Flow_0bmwscr</outgoing>
    </serviceTask>
    <serviceTask id="Task_CloreArchiverDemande" name="Clôturer et archiver la demande" camunda:type="external" camunda:topic="cloturer-archiver-demande">
      <incoming>sf_accepte</incoming>
      <incoming>sf_refus_definitif</incoming>
      <outgoing>sf_cloture_end</outgoing>
    </serviceTask>
    <endEvent id="EndEvent_Cloturee" name="Demande clôturée">
      <incoming>sf_cloture_end</incoming>
    </endEvent>
    <exclusiveGateway id="GW_RefusPartiel" name="Autres banques éligibles ?" default="sf_refus_definitif">
      <incoming>sf_refuse</incoming>
      <outgoing>sf_refus_partiel</outgoing>
      <outgoing>sf_refus_definitif</outgoing>
    </exclusiveGateway>
    <sequenceFlow id="sf_1" sourceRef="StartEvent_Debut" targetRef="Task_AnalyserDemande" />
    <sequenceFlow id="sf_2" sourceRef="Task_AnalyserDemande" targetRef="Task_VerifierCoherence" />
    <sequenceFlow id="sf_3" sourceRef="Task_VerifierCoherence" targetRef="GW_Coherence" />
    <sequenceFlow id="sf_incoherent" name="Non" sourceRef="GW_Coherence" targetRef="Activity_0juifhr" />
    <sequenceFlow id="sf_coherent" name="Oui" sourceRef="GW_Coherence" targetRef="Task_GenererRecommandations">
      <conditionExpression xsi:type="tFormalExpression">${coherent == true}</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="sf_5" sourceRef="Task_GenererRecommandations" targetRef="Task_SoumettreDemande" />
    <sequenceFlow id="sf_8" sourceRef="Task_SoumettreDemande" targetRef="Task_ValiderConsentement" />
    <sequenceFlow id="Flow_0wwwpgy" sourceRef="Activity_0juifhr" targetRef="Task_AnalyserDemande" />
    <sequenceFlow id="sf_client_3" sourceRef="Task_ValiderConsentement" targetRef="Task_Prescoring" />
    <sequenceFlow id="sf_11" sourceRef="Task_Prescoring" targetRef="GW_Score" />
    <sequenceFlow id="sf_score_faible" name="PD &#62; 60 %" sourceRef="GW_Score" targetRef="EndEvent_RejetAuto" />
    <sequenceFlow id="sf_score_ok" name="Score moyen/élevé" sourceRef="GW_Score" targetRef="Task_RouterDemande">
      <conditionExpression xsi:type="tFormalExpression">${scoreOk == true}</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="sf_12" sourceRef="Task_RouterDemande" targetRef="Task_PriseEnCharge" />
    <sequenceFlow id="sf_pec_to_ins" sourceRef="Task_PriseEnCharge" targetRef="Task_PrendreDecision" />
    <sequenceFlow id="sf_timer_to_exp" sourceRef="Timer_Expiration48h" targetRef="Task_ExpirerVerrou" />
    <sequenceFlow id="sf_exp_to_pec" sourceRef="Task_ExpirerVerrou" targetRef="Task_PriseEnCharge" />
    <sequenceFlow id="sf_accepte" name="Accepter" sourceRef="GW_Decision" targetRef="Task_CloreArchiverDemande">
      <conditionExpression xsi:type="tFormalExpression">${decision == 'ACCEPTER'}</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="sf_cloture_end" sourceRef="Task_CloreArchiverDemande" targetRef="EndEvent_Cloturee" />
    <sequenceFlow id="sf_refuse" name="Refuser" sourceRef="GW_Decision" targetRef="GW_RefusPartiel">
      <conditionExpression xsi:type="tFormalExpression">${decision == 'REFUSER'}</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="sf_complement" name="Infos complémentaires" sourceRef="GW_Decision" targetRef="Task_DemanderComplement" />
    <sequenceFlow id="sf_refus_partiel" name="Refus partiel" sourceRef="GW_RefusPartiel" targetRef="Task_PriseEnCharge">
      <conditionExpression xsi:type="tFormalExpression">${refusPartiel == true}</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="sf_refus_definitif" name="Refus définitif" sourceRef="GW_RefusPartiel" targetRef="Task_CloreArchiverDemande" />
    <sequenceFlow id="Flow_0bmwscr" sourceRef="Task_DemanderComplement" targetRef="Task_PrendreDecision" />
    <sequenceFlow id="sf_analyste_3" sourceRef="Task_PrendreDecision" targetRef="GW_Decision" />
    <subProcess id="SubProcess_AnnulationCommercant" name="Annulation commerçant" triggeredByEvent="true">
      <startEvent id="StartEvent_AnnulationCommercant" name="Annulation commerçant">
        <outgoing>sf_annul_start</outgoing>
        <messageEventDefinition id="MessageEventDef_AnnulationCommercant" messageRef="Message_AnnulationCommercant" />
      </startEvent>
      <serviceTask id="Task_AnnulerDemande" name="Annuler demande" camunda:type="external" camunda:topic="annuler-demande">
        <incoming>sf_annul_start</incoming>
        <outgoing>sf_annul_to_end</outgoing>
      </serviceTask>
      <endEvent id="EndEvent_Annulee" name="Demande annulée">
        <incoming>sf_annul_to_end</incoming>
        <terminateEventDefinition id="TerminateEventDefinition_Annulee" />
      </endEvent>
      <sequenceFlow id="sf_annul_start" sourceRef="StartEvent_AnnulationCommercant" targetRef="Task_AnnulerDemande" />
      <sequenceFlow id="sf_annul_to_end" sourceRef="Task_AnnulerDemande" targetRef="EndEvent_Annulee" />
    </subProcess>
  </process>
